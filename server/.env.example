# Copia este archivo a .env y ajusta los valores
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uniguajira_news
JWT_SECRET=genera_uno_con_openssl_rand_hex_32
CORS_ORIGIN=*

# Scraper WordPress: por defecto descarga 100 publicaciones recientes (2 x 50).
# Aumenta SCRAPER_MAX_PAGES si necesitas más histórico.
SCRAPER_POSTS_PER_PAGE=50
SCRAPER_MAX_PAGES=2
SCRAPER_MAX_DETAIL_REQUESTS=30
SCRAPER_DETAIL_CONCURRENCY=4
