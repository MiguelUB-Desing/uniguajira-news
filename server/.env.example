# Copia este archivo a .env y ajusta los valores
PORT=3000
NODE_ENV=development

# Opción A: variables individuales (desarrollo local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uniguajira_news

# Opción B: URL completa (producción: Aiven / Render / Railway)
# Formato: mysql://USER:PASSWORD@HOST:PORT/DBNAME?ssl=true
# DATABASE_URL=mysql://user:pass@host:3306/uniguajira_news?ssl=true

JWT_SECRET=genera_uno_con_openssl_rand_hex_32

# Orígenes permitidos CORS (separados por coma)
# Ej: https://tu-app.pages.dev,http://localhost:5173
CORS_ORIGIN=*

# Scraper WordPress
SCRAPER_POSTS_PER_PAGE=50
SCRAPER_MAX_PAGES=2
SCRAPER_MAX_DETAIL_REQUESTS=30
SCRAPER_DETAIL_CONCURRENCY=4
