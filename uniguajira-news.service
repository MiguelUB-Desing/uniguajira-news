[Unit]
Description=UniGuajira News - Servidor Proxy y App Móvil
After=network.target

[Service]
Type=simple
User=miguel
WorkingDirectory=/home/miguel/uniguajira-news/server
ExecStart=/home/miguel/.local/node22/bin/node /home/miguel/uniguajira-news/server/src/index.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DB_HOST=localhost
Environment=DB_PORT=3306
Environment=DB_USER=root
Environment=DB_PASSWORD=
Environment=DB_NAME=uniguajira_news
Environment=CORS_ORIGIN=*

[Install]
WantedBy=multi-user.target