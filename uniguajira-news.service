[Unit]
Description=UniGuajira News - Servidor Proxy y App Móvil
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=miguel
WorkingDirectory=/home/miguel/proyecto_de_grado/server
ExecStart=/usr/bin/node /home/miguel/proyecto_de_grado/server/src/index.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DB_HOST=localhost
Environment=DB_PORT=3306
Environment=DB_USER=root
Environment=DB_PASSWORD=uniguajira2026
Environment=DB_NAME=uniguajira_news

[Install]
WantedBy=multi-user.target
